# LSC environment variables
#
# Copy this file to `.env` in the project root and adjust the values.
# config/bootstrap.php loads `.env` automatically; variables that are
# already set in the real environment (Railway, hPanel, systemd) always
# take precedence. Never commit `.env` — it is git-ignored.

# MySQL (required)
# Matches the credentials of `docker compose -f database/docker-compose.yml up -d`
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLDATABASE=lsc_db
MYSQLUSER=lsc_user
MYSQLPASSWORD=lsc_pass

# Public base URL used in password-reset and invitation links (recommended)
APP_URL=http://localhost:8000

# Set to "production" on a live server to enforce production session and
# error settings. Leave unset for local/demo work: without it, the
# forgot-password page shows the reset link on screen instead of emailing it.
#APP_ENV=production

# Set to 1 only while debugging locally; never in production.
#APP_DEBUG=1

# Sender address for PHP mail() password-reset delivery.
#MAIL_FROM=no-reply@example.com

# Outbound notification providers (used by bin/process-notification-queue.php)
#RESEND_API_KEY=
#RESEND_FROM_EMAIL=
#AFRICASTALKING_USERNAME=
#AFRICASTALKING_API_KEY=

# Set to "cloudflare" only when the app sits behind Cloudflare, so the rate
# limiter reads the real client IP instead of the proxy address.
#TRUSTED_PROXY=cloudflare
