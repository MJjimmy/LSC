# LSC environment variables
#
# Copy this file to `.env` in the project root and adjust the values.
# config/bootstrap.php loads `.env` automatically; variables that are already
# set in the real environment (Railway, systemd, hPanel) always take
# precedence. Never commit `.env` — it is git-ignored.

# ---------------------------------------------------------------------------
# MySQL (required)
# Matches the credentials of `docker compose -f database/docker-compose.yml up -d`
# ---------------------------------------------------------------------------
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLDATABASE=lsc_db
MYSQLUSER=lsc_user
MYSQLPASSWORD=lsc_pass

# ---------------------------------------------------------------------------
# Public URL (REQUIRED in production)
#
# Absolute origin of the deployment: scheme + host, no path, query or
# fragment. Every emailed link (password reset, group invitation, email
# ownership proof) is built from this value, and the server refuses to
# create those links when it is missing or invalid rather than trusting the
# request Host header. Development may use http://localhost:8000.
# ---------------------------------------------------------------------------
APP_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
# "production" enforces HTTPS, HSTS, secure cookies and the strict link rules.
# Leave unset for local work.
#APP_ENV=production

# Set to 1 to display PHP errors locally only. Never set this in production.
#APP_DEBUG=1

# Local convenience: render password-reset links on screen instead of
# emailing them. Ignored whenever APP_ENV=production.
#APP_SHOW_RESET_LINKS=1

# ---------------------------------------------------------------------------
# Email delivery (Resend)
# Required for email ownership proof, password resets and invitations.
# ---------------------------------------------------------------------------
#EMAIL_DELIVERY_ENABLED=1
#RESEND_API_KEY=
#RESEND_FROM_EMAIL=no-reply@example.ac.za

# ---------------------------------------------------------------------------
# SMS delivery (Africa's Talking) — optional
# ---------------------------------------------------------------------------
#AFRICASTALKING_USERNAME=
#AFRICASTALKING_API_KEY=
#AFRICASTALKING_SENDER_ID=

# ---------------------------------------------------------------------------
# Notification queue worker
# NOTIFICATION_PROCESSOR_ENABLED=1 starts the supervised worker inside the
# runtime; NOTIFICATION_WORKER_ENABLED=1 additionally allows it to send.
# The two cutover guards are optional: only rows created at/after this UTC
# timestamp and at/above this queue id are ever sent.
# ---------------------------------------------------------------------------
#NOTIFICATION_PROCESSOR_ENABLED=0
#NOTIFICATION_WORKER_ENABLED=0
#NOTIFICATION_SEND_AFTER=2026-01-01 00:00:00
#NOTIFICATION_MIN_QUEUE_ID=1

# ---------------------------------------------------------------------------
# Google sign-in (optional)
# Redirect URI: APP_URL/oauth.php?provider=google
# Leave unset to hide the Google button.
# ---------------------------------------------------------------------------
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Rate limiting behind a proxy
#
# The shipped runtime terminates HTTP in front of php-fpm, so REMOTE_ADDR is
# the proxy. List the proxies you control; forwarded headers are ignored
# unless the direct peer matches one of them.
#
#   TRUSTED_PROXIES=10.0.0.0/8,203.0.113.7
#   TRUSTED_PROXIES=cloudflare          # Cloudflare only
#   TRUSTED_PROXIES=loopback            # local nginx/Caddy in front of PHP
#
# TRUSTED_PROXY=cloudflare is still honoured for older deployments.
# ---------------------------------------------------------------------------
#TRUSTED_PROXIES=loopback

# Port used by the managed nginx/php-fpm runtime.
#PORT=8080
