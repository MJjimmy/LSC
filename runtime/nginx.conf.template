worker_processes auto;
pid /tmp/lsc/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    server_tokens off;
    client_max_body_size 110M;
    client_body_temp_path /tmp/lsc/client-body;
    fastcgi_temp_path /tmp/lsc/fastcgi;
    proxy_temp_path /tmp/lsc/proxy;
    uwsgi_temp_path /tmp/lsc/uwsgi;
    scgi_temp_path /tmp/lsc/scgi;
    server {
        listen __PORT__;
        root /app/public;
        index index.php;
        error_page 404 /404.php;
        location = /healthz {
            include /etc/nginx/fastcgi_params;
            fastcgi_param SCRIPT_FILENAME /healthz;
            fastcgi_param HTTP_PROXY "";
            fastcgi_pass unix:/tmp/lsc/php-fpm.sock;
        }
        location ~ (^|/)\. { return 404; }
        location / { try_files $uri $uri/ =404; }
        location ~ \.php$ {
            try_files $uri =404;
            include /etc/nginx/fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param HTTP_PROXY "";
            fastcgi_pass unix:/tmp/lsc/php-fpm.sock;
            fastcgi_read_timeout 65s;
        }
    }
}
