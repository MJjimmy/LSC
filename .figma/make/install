#!/usr/bin/env bash
set -euo pipefail

php_root="${HOME}/.local/share/figma-make/php-8.4"
extension_dir="${php_root}/usr/lib/php/20240924"
library_dir="${php_root}/usr/lib/x86_64-linux-gnu"

exec env LD_LIBRARY_PATH="${library_dir}" \
  "${php_root}/usr/bin/php8.4" -n \
  -d "extension_dir=${extension_dir}" \
  -d extension=pdo \
  -d extension=pdo_pgsql \
  -d extension=curl \
  -d extension=mbstring \
  -d extension=fileinfo \
  -r 'foreach (["pdo_pgsql", "mbstring", "curl", "fileinfo"] as $extension) {
      if (!extension_loaded($extension)) {
          fwrite(STDERR, "Missing required PHP extension: {$extension}" . PHP_EOL);
          exit(1);
      }
  }'
