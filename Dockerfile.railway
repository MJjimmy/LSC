# Patched, digest-pinned production runtime; local Docker files are untouched.
FROM cgr.dev/chainguard/wolfi-base@sha256:c2a4815b6ca49b9bbafd451b4bde690d567a86b2b6b54877faac8082a7bc4296 AS ownership
RUN apk add --no-cache su-exec=0.3-r4 \
    && echo "8acfb0194081dc849e385cbe7bf1737257fcf6decf865c1bdeb961b9a763029b  /usr/bin/su-exec" | sha256sum -c -
FROM cgr.dev/chainguard/nginx@sha256:d74ba9e5cf9f6b049807e27a5a14a8cd2550ac428143b7d15ea3dbad282f4ed1 AS nginx
# PHP 8.5.12 FPM: security release; vendor signature and SBOM verified.
FROM cgr.dev/chainguard/php@sha256:8cdaa7a48161331e1de2df8cce48c02d2b67890aaf629823172790e05c7f4738
COPY --from=ownership /usr/bin/su-exec /usr/bin/su-exec
COPY --from=nginx /usr/sbin/nginx /usr/sbin/nginx
COPY --from=nginx /etc/nginx/mime.types /etc/nginx/mime.types
COPY --from=nginx /etc/nginx/fastcgi_params /etc/nginx/fastcgi_params
WORKDIR /app
COPY app /app/app
COPY bin /app/bin
COPY config /app/config
COPY public /app/public
COPY views /app/views
COPY runtime /app/runtime
COPY php.ini /etc/php/conf.d/99-lsc.ini
COPY --chown=65532:65532 storage/uploads /app/storage/uploads
COPY --chmod=0755 runtime/start /app/runtime/start
COPY --chmod=0755 runtime/volume-entrypoint /app/runtime/volume-entrypoint
COPY --chmod=0755 runtime/services /app/runtime/services
ENV APP_ENV=production APP_DEBUG=0 APP_SHOW_RESET_LINKS=0
USER 65532:65532
RUN ["/usr/sbin/nginx", "-V"]
RUN ["/bin/php", "-r", "if (PHP_VERSION !== '8.5.12') { fwrite(STDERR, 'Unexpected PHP runtime version'.PHP_EOL); exit(1); } echo 'Verified PHP runtime: '.PHP_VERSION.PHP_EOL;"]
RUN ["/bin/php", "-l", "/app/runtime/prepare.php"]
EXPOSE 8080
ENTRYPOINT ["/app/runtime/volume-entrypoint"]
